{
  "manifest_version": 3,
  "name": "Personal Memory · 浏览器提问采集",
  "version": "0.4.0",
  "description": "采集已授权 AI 网页中已发送的用户提问，同步到本机 Personal Memory。",
  "permissions": [
    "storage",
    "scripting",
    "nativeMessaging",
    "activeTab",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Personal Memory"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
